# App
APP_NAME=event-backend
APP_ENV=development
DEBUG=true

# Database
POSTGRES_USER=eventuser
POSTGRES_PASSWORD=eventpass
POSTGRES_DB=eventdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Derived — used by the app
DATABASE_URL=postgresql+asyncpg://eventuser:eventpass@db:5432/eventdb

JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
